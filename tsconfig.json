{
  "compilerOptions": {
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "lib": ["es2023", "dom"],
    "module": "NodeNext",
    "outDir": "./dist",
    "rewriteRelativeImportExtensions": true,
    "target": "es2022",
    "types": ["vitest/globals", "node"]
  },
  // These may be different for your repo:
  "include": ["./src"],
  "exclude": ["**/*/*.test.*", "**/*.test-d.ts", "node_modules", "dist", "src/example.ts"]
}
