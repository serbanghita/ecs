{
  "name": "@serbanghita-gamedev/ecs",
  "description": "ECS library",
  "keywords": [
    "ecs",
    "entity component system"
  ],
  "main": "./src/index.ts",
  "type": "module",
  "version": "2.0.0",
  "author": "Serban Ghita <serbanghita@gmail.com> (https://ghita.org)",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run typecheck",
    "build": "esbuild ./src/index.ts --bundle --outfile=dist/ecs.js  --keep-names",
    "build:example": "esbuild ./src/example.ts --bundle --outfile=dist/example.js --keep-names",
    "build:demo": "esbuild ./src/demo/demo.ts --bundle --outfile=dist/demo.js --keep-names --sourcemap",
    "dev:demo": "esbuild ./src/demo/demo.ts --bundle --outfile=dist/demo.js --keep-names --sourcemap --watch --servedir=dist --serve=8080",
    "test": "vitest --watch=false",
    "lint": "eslint ./src"
  },
  "dependencies": {
    "@serbanghita-gamedev/bitmask": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/eslint__js": "8.42.3",
    "@vitest/coverage-istanbul": "3.2.4",
    "esbuild": "0.25.10",
    "eslint": "9.36.0",
    "jest": "30.1.3",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vite-tsconfig-paths": "4.3.2",
    "vitest": "3.2.4"
  }
}
